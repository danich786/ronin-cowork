#!/usr/bin/env bash
# koshi — the watcher that follows every session's turns.
# Usage: koshi                  run forever; this is the process a Koshi tile runs
#        koshi --dry-run        print every turn it sees
#        koshi --once           one pass over every live session, then exit
#        koshi start [--dry-run]  spawn the watchable tile (tmux session "koshi", tagged koshi)
#
# Koshi IGNORES the dial: it is house machinery, the same category as the recorder, which
# already tapes every pane whatever the dial says.
#
# WHAT IT DOES: follows every session's tape (RIREKI is the wake — nothing polls tmux),
# decodes the arriving lines and notices when a turn ended. It asks nothing, writes
# nothing and says nothing.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec npx --prefix "$HERE" tsx "$HERE/src/services/koshi/koshi.ts" "$@"
