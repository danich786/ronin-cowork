#!/usr/bin/env bash
# RONIN GATE — wait for the server, then check that the PAGE ACTUALLY WORKS.
#
# Wired to ExecStartPost in the systemd unit, so every start/restart is checked
# whether or not anybody remembered to. The verdict lands in the journal:
#
#   journalctl --user -u ronin -f | grep 'RONIN GATE'
#
# It is a REPORTER, not a killer: it never fails the unit (the unit is prefixed with
# `-` and this runs detached). A broken UI that is up and complaining loudly beats a
# restart loop that takes the box down. `bin/ronin-deploy` is the version whose exit
# code you should care about.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
say() { :; } # render_check requires a progress reporter; this gate grades by return code below.
# shellcheck source=ronin-render-check.sh
. "$ROOT/libexec/ronin-render-check.sh"
# The service's Node process reads .env itself; ExecStartPost does not inherit that
# process's environment. Read the same file with dotenv (never source it as shell).
# Explicit service environment still wins, just as it does for the application.
if ! ADDRESS="$(cd "$ROOT" && node -e '
  require("dotenv").config();
  console.log(process.env.PORT || "4810", process.env.BIND?.trim() || "unset");
')"; then
  echo 'RONIN GATE: FAIL — could not read the backend configuration'
  exit 0
fi
read -r PORT HOSTIP <<< "$ADDRESS"
PORT="${PORT:-4810}"
if [ -n "${HOSTIP:-}" ] && [ "$HOSTIP" != unset ]; then
  :
elif command -v tailscale >/dev/null 2>&1 && tailscale ip -4 >/dev/null 2>&1; then
  HOSTIP="$(tailscale ip -4 | head -1)"
else
  HOSTIP="127.0.0.1"
fi
case "$HOSTIP" in
  0.0.0.0) HOSTIP=127.0.0.1 ;;
  ::) HOSTIP='[::1]' ;;
  *:*) HOSTIP="[$HOSTIP]" ;;
esac
URL="${RONIN_GATE_URL:-http://${HOSTIP}:${PORT}/}"

# Wait for the server to answer at all (up to ~40s).
for _ in $(seq 1 40); do
  if curl -fsS -m 2 -o /dev/null "${URL}api/health" 2>/dev/null; then ready=1; break; fi
  sleep 1
done
if [ -z "${ready:-}" ]; then
  echo "RONIN GATE: FAIL — server never answered ${URL}api/health"
  exit 0
fi

if render_check "$ROOT" "$URL" "$URL"; then rc=0; else rc=$?; fi
case "$rc" in
  0) echo "RONIN GATE: PASS — $URL — ${RENDER_VERDICT:-rendered}" ;;
  2) echo "RONIN GATE: SKIP — $RENDER_REPORT" ;;
  *)
    echo "RONIN GATE: FAIL — $URL is serving a broken UI"
    printf '%s\n' "$RENDER_DETAILS" | sed 's/^/RONIN GATE: /'
    ;;
esac
exit 0
