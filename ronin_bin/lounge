#!/usr/bin/env bash
# lounge — the person's Business Lounge record. The park writes it into the office as
# office_unit/lounge.json; the Ronin Services part `account` (GET /api/account/record) reads it;
# this tool only prints (KAN-677).
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" lounge "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
usage() { cat <<'EOF_USAGE'
Usage:
  lounge          the person's lounge record, as of the time it carries: subscription, balance,
                  this office's rental and limit, default models, people, other offices, About you
  lounge --json   the record as the park wrote it
The park keeps it current within 30 seconds of a change at HQ. Read-only: the person makes
account changes in the Business Lounge (hq.roninhosted.com). Hosted offices only.
EOF_USAGE
}
json=''
case "${1:-}" in
  '') ;;
  --json) json=1 ;;
  -h|--help) usage; exit 0 ;;
  *) echo "lounge: unknown argument $1 (lounge --help)" >&2; exit 2 ;;
esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
out=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -w '\n%{http_code}' "$url/api/account/record") || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; exit 5; }
printf '%s' "${out%$'\n'*}" | REPLY_STATUS=${out##*$'\n'} AS_JSON=$json python3 -c '
import json, os, sys
status = os.environ["REPLY_STATUS"]
try: d = json.loads(sys.stdin.read())
except Exception:
    if status == "404": print("The lounge record needs Ronin Services (the account part); it is not running here.", file=sys.stderr); sys.exit(4)
    print("HTTP %s: Ronin answered without JSON" % status, file=sys.stderr); sys.exit(3)
if not d.get("ok"): print(d.get("error") or "HTTP %s" % status, file=sys.stderr); sys.exit(3)
if os.environ["AS_JSON"] and "record" in d: print(json.dumps(d["record"], indent=2)); sys.exit(0)
print("\n".join(d.get("lines", [])))
sys.exit(0 if d.get("state") == "current" else 4)
'
