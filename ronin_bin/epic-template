#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" epic-template "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
die() { echo "$1" >&2; exit "${2:-2}"; }
usage() { cat <<'EOF_USAGE'
Usage:
  epic-template list                       every template: name, title, what it is for
  epic-template start <name> [--to <agent>] [--workspace <w>]
                                           make its epic and tasks, held by the Agent, and tell it
                                           to walk the epic through
A template is one file in epic_templates/: the epic's title and text, then its tasks in
order (## <title>, each Do / Details / Check), a task's subtasks under it (### <title>).
Your own in ~/ronin/epic_templates/ add one, or replace a stock one by name; nothing else
needs changing. A template never names an item id: the tasks are the epic's children.
start makes the epic, its tasks and their subtasks through the item tools, each held by the
Agent from birth, and sends it one line: walk this epic through, with the epic's id. The
Agent is you unless --to names another (a new one: session_create first). --workspace is
the epic's last line, so the Agent knows where the work is. It answers "started <epic> from <name>" and the task ids.
Related: ronin-help epic-templates; item --help; session_create --help
EOF_USAGE
}
case "${1:-}" in -h|--help|'') [ "$#" -le 1 ] || die 'Run epic-template --help.'; usage; [ "$#" -eq 1 ]; exit $?;; esac
for a in "$@"; do case "$a" in -h|--help) usage; exit 0;; esac; done
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
BY=$(ronin_session_me 2>/dev/null || id -un)
# call METHOD PATH [JSON]: the reply on stdout, an error on stderr with exit 3.
call() {
  local args=(-sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -X "$1")
  [ -z "${3-}" ] || args+=(-H 'content-type: application/json' --data "$3")
  local out; out=$(curl "${args[@]}" "$url$2") || die "UNREACHABLE: Ronin did not answer at $url" 5
  printf '%s' "$out" | python3 -c 'import json,sys
try: d = json.loads(sys.stdin.read())
except Exception: sys.exit("Ronin answered without JSON")
if isinstance(d, dict) and d.get("error"): sys.exit(d["error"])
print(json.dumps(d))' || exit 3
}
verb=$1; shift
case "$verb" in
  list) [ "$#" -eq 0 ] || die 'BAD-ARG: epic-template list takes nothing'
    call GET /api/epic-templates | python3 -c 'import json,sys
for t in json.load(sys.stdin)["templates"]:
    print("%s  %s%s%s" % (t["name"], t["title"], " — " + t["for"] if t["for"] else "", " (yours)" if t["origin"] == "user" else ""))'
    ;;
  start) name=${1:-}; [ -n "$name" ] && [ "${name#-}" = "$name" ] || die 'BAD-ARG: epic-template start takes <name>; epic-template list shows them'; shift
    to=''; workspace=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --to|--workspace) [ -n "${2:-}" ] || die "BAD-ARG: $1 needs a value"; eval "${1#--}=\$2"; shift 2 ;;
        *) die "BAD-ARG: epic-template start takes --to or --workspace, not $1" ;;
      esac
    done
    body=$(python3 -c 'import json,sys; a = sys.argv[1:]; print(json.dumps({k: v for k, v in zip(a[::2], a[1::2]) if v}))' by "$BY" to "$to" workspace "$workspace")
    call POST "/api/epic-templates/$name/start" "$body" | python3 -c 'import json,sys
d = json.load(sys.stdin); print("started %s from %s" % (d["epic"], sys.argv[1])); print("tasks: " + " ".join(d["tasks"]))
if d.get("told"): print("told: " + d["told"])' "$name"
    ;;
  *) usage >&2; exit 2 ;;
esac
