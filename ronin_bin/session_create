#!/usr/bin/env bash
# session_create — explicitly create one new Agent through the ordinary launch route.
set -u
case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || { echo "session_create: --help takes no other arguments. Run session_create --help." >&2; exit 2; }
    cat <<'EOF'
session_create — create one new Agent

Usage:
  session_create <name> [--prompt <text>] [--team <team>] [--project <id>] [--lead]
                        [--root <path>] [--model <name>]
                        [--mode manual|assisted] [--cmd <cli>]
                        [--mcp on|off] [--tags a,b] [--seed p1,p2]

Creation is always explicit. An existing name is refused rather than read or updated.
With no --team, the new Agent joins the caller's first Team when there is one.
--project raises the Agent for one roster-held project: the brief names the project,
then the whole project moves into the newborn's work record. A failed move is reported
as a partial result; it never claims the project was installed.
Related: session_check --help; session_set --help; tejun-fork
EOF
    exit 0 ;;
esac
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
die() { printf '%s\n' "$1" >&2; exit "${2:-4}"; }
need_value() {
  [ "$#" -ge 2 ] && [ -n "$2" ] && [ "${2#-}" = "$2" ] \
    || die "BAD-ARG: $1 requires a value. Run session_create --help." 2
}
NAME="${1:-}"
[ -n "$NAME" ] && [ "${NAME#-}" = "$NAME" ] || die "usage: session_create <name> [options]. Run session_create --help." 2
shift
PROMPT="" TEAM="" PROJECT="" LEAD="" ROOT="" MODE="" CMD="" MODEL="" MCP="" TAGS="" SEED=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt) need_value "$@"; PROMPT="$2"; shift 2 ;;
    --team) need_value "$@"; TEAM="$2"; shift 2 ;;
    --project) need_value "$@"; PROJECT="$2"; shift 2 ;;
    --lead) LEAD=1; shift ;;
    --root|--project_root) need_value "$@"; ROOT="$2"; shift 2 ;;
    --mode) need_value "$@"; MODE="$2"; shift 2 ;;
    --cmd) need_value "$@"; CMD="$2"; shift 2 ;;
    --model) need_value "$@"; MODEL="$2"; shift 2 ;;
    --mcp) need_value "$@"; MCP="$2"; shift 2 ;;
    --tags) need_value "$@"; TAGS="$2"; shift 2 ;;
    --seed) need_value "$@"; SEED="$2"; shift 2 ;;
    *) die "BAD-ARG: $1. Run session_create --help." 2 ;;
  esac
done

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
if [ -n "$PROJECT" ]; then
  PROJECT_TEAM=${PROJECT%%/*}
  PROJECT_NUMBER=${PROJECT#*/}
  [ "$PROJECT_TEAM" != "$PROJECT" ] && [ -n "$PROJECT_TEAM" ] && [[ "$PROJECT_NUMBER" =~ ^[0-9]+$ ]] \
    || die "BAD-ARG: --project needs a canonical <team>/<number> id." 2
  [ -z "$TEAM" ] || [ "$TEAM" = "$PROJECT_TEAM" ] \
    || die "BAD-ARG: project $PROJECT belongs to Team $PROJECT_TEAM, not $TEAM." 2
  TEAM=$PROJECT_TEAM
  roster=$(curl -sS -m 15 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" "$url/api/team-rosters/$TEAM" 2>/dev/null) \
    || die "UNREACHABLE: Ronin did not answer at $url" 5
  PROJECT_BRIEF=$(ROSTER_JSON="$roster" python3 - "$PROJECT" <<'PY'
import json, os, sys
project_id = sys.argv[1]
try: data = json.loads(os.environ["ROSTER_JSON"])
except Exception: raise SystemExit(2)
project = next((p for p in data.get("projects", []) if p.get("id") == project_id), None)
if not project: raise SystemExit(3)
print(f'Project {project_id}: {project.get("title", "")}. {project.get("objective", "")} Check your work record for the whole project.')
PY
  ) || die "NO-PROJECT: $PROJECT is not held in Team $TEAM's roster." 3
  PROMPT=$(printf '%s\n%s' "$PROMPT" "$PROJECT_BRIEF" | sed '/^$/d')
fi

CALLER=$(ronin_session_me 2>/dev/null || true)
body=$(NAME="$NAME" CALLER="$CALLER" PROMPT="$PROMPT" TEAM="$TEAM" LEAD="$LEAD" ROOT="$ROOT" \
       MODE="$MODE" CMD="$CMD" MODEL="$MODEL" MCP="$MCP" TAGS="$TAGS" SEED="$SEED" python3 - <<'PY'
import json, os
e = os.environ
b = {"name": e["NAME"]}
if e["CALLER"]: b["caller"] = e["CALLER"]
for k, v in (("prompt", "PROMPT"), ("team", "TEAM"), ("project_root", "ROOT"),
             ("mode", "MODE"), ("cmd", "CMD"), ("model", "MODEL")):
    if e[v]: b[k] = e[v]
if e["LEAD"]: b["team_lead"] = True
if e["MCP"]: b["mcp"] = e["MCP"].lower() in ("on", "true", "1", "yes")
for k, v in (("tags", "TAGS"), ("seed", "SEED")):
    if e[v]: b[k] = [t.strip() for t in e[v].split(",") if t.strip()]
print(json.dumps(b))
PY
) || die "BAD-ARG: could not build the request" 2

out=$(mktemp /tmp/session_create.XXXXXX) || exit 2
code=$(curl -sS -m 60 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$out" -w '%{http_code}' \
       -H 'content-type: application/json' -X POST --data "$body" "$url/api/session" 2>/dev/null) \
  || { rm -f "$out"; die "UNREACHABLE: Ronin did not answer at $url" 5; }
python3 - "$code" "$out" <<'PY'
import json, sys
code, path = int(sys.argv[1]), sys.argv[2]
try: d = json.load(open(path))
except Exception: d = {}
if code == 200 and d.get("ok"):
    r = d.get("receipt") or {}
    team = r.get("team") or ""
    how = d.get("team_from", "none")
    tail = f"on {team}" + (" (your team)" if how == "caller" else "") if team else "(rōnin)"
    if r.get("team_lead"): tail += " as 人"
    print(f"BORN {d.get('name')} {tail}")
    raise SystemExit(0)
print(f"REFUSED: {d.get('error') or f'HTTP {code}'}", file=sys.stderr)
raise SystemExit(4)
PY
rc=$?
rm -f "$out"
[ "$rc" -eq 0 ] || exit "$rc"
if [ -n "$PROJECT" ]; then
  assign_body=$(NAME="$NAME" python3 -c 'import json,os; print(json.dumps({"session": os.environ["NAME"]}))')
  assign_out=$(mktemp /tmp/session_create_project.XXXXXX) || exit 2
  assign_code=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$assign_out" -w '%{http_code}' \
    -H 'content-type: application/json' -X POST --data "$assign_body" \
    "$url/api/team-rosters/$TEAM/projects/$PROJECT_NUMBER/assign" 2>/dev/null) || assign_code=000
  if [ "$assign_code" != 200 ] || ! python3 - "$assign_out" <<'PY'
import json, sys
try: data=json.load(open(sys.argv[1]))
except Exception: raise SystemExit(1)
raise SystemExit(0 if data.get("ok") else 1)
PY
  then
    detail=$(python3 - "$assign_out" <<'PY'
import json, sys
try: print(json.load(open(sys.argv[1])).get("error") or "project placement failed")
except Exception: print("project placement failed")
PY
)
    rm -f "$assign_out"
    die "PARTIAL: $NAME was born, but project $PROJECT was not installed: $detail" 6
  fi
  rm -f "$assign_out"
  printf 'ASSIGNED %s to %s — check your work record\n' "$PROJECT" "$NAME"
fi
exit 0
