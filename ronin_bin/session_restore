#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" session_restore "$@"
# session_restore — list the archives, or restore one through Ronin's existing resume path.
# Usage: session_restore [<archive-id> | --all]
set -u
case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || { echo "session_restore: --help takes no other arguments. Run session_restore --help." >&2; exit 2; }
    cat <<'EOF'
session_restore — list the archives, or resume one archived session

Usage:
  session_restore               list the archives there are, newest first
  session_restore <archive-id>  restore one
  session_restore --all         restore all that session_archive --all saved

With no argument it lists each archive: name, team, when it was archived, its id and the
line that restores it. An archive is there to undo an accidental close: it lasts 7 days,
then Ronin removes it with its session folder.

Use the archive id printed by session_archive, or named in a lead's notice that an Agent
ended with session_end (every session_end archives). Ronin restores the provider
conversation and session metadata; the archive is removed only after restoration succeeds.
Restore does not give back work items: the restored Agent takes back its items (item handoff).
A worktree closed at the end it reopens (worktree-desk open). One archived with
session_archive --ignore-desks was left open: the restored Agent is back at that same desk,
its uncommitted work as it was.

  session_restore --all [--status <file>]

Restore all: brings back every Agent session_archive --all saved and is not already running,
under the same name and in the same place, each continuing its conversation, with its Teams,
leads, items and desks as they were. Each is named, back or not and why. Run it again and
it does nothing more; with nothing saved it does nothing.
--status <file> starts it detached and returns at once: <file> reads {"state":"running"},
then {"state":"done","restored":[{name,id}],"not_restored":[{name,id,error}]} or
{"state":"failed","error"}. It is done or failed within 600 s.
Related: session_archive --help, session_end --help
EOF
    exit 0 ;;
esac
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
if [ "${1-}" = --all ]; then
  shift
  . "$TOOL_DIR/ronin-all.sh"
  ronin_all restore-all "$@"
  exit $?
fi
[ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ -n "$1" ] && [ "${1#-}" = "$1" ]; } || {
  echo "usage: session_restore [<archive-id>]. Run session_restore --help." >&2
  exit 2
}
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
out=$(mktemp)
trap 'rm -f "$out"' EXIT
if [ "$#" -eq 0 ]; then
  code=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$out" -w '%{http_code}' \
    "$url/api/archived-sessions" 2>/dev/null) || {
    echo "UNREACHABLE: Ronin did not answer at $url" >&2
    exit 5
  }
  python3 - "$code" "$out" <<'PY'
import json, sys
code, path = int(sys.argv[1]), sys.argv[2]
try:
    data = json.load(open(path))
except Exception:
    data = None
if code != 200 or not isinstance(data, list):
    err = data.get("error") if isinstance(data, dict) else None
    print(f"REFUSED: {err or f'HTTP {code}'}", file=sys.stderr)
    raise SystemExit(4)
if not data:
    print("No archives. An archive lasts 7 days.")
    raise SystemExit(0)
print(f"{len(data)} archive(s), newest first; each lasts 7 days:")
for a in data:
    team = ", ".join(a.get("tags") or []) or "no team"
    when = (a.get("archived_at") or "?").replace("T", " ")[:16]
    print(f"  {a.get('name') or '?'} · {team} · {when} UTC · {a.get('id')}")
    print(f"    session_restore {a.get('id')}")
PY
  exit $?
fi
ID=$1
code=$(curl -sS -m 60 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$out" -w '%{http_code}' \
  -H 'content-type: application/json' -X POST "$url/api/archived-sessions/$ID/rehydrate" 2>/dev/null) || {
  echo "UNREACHABLE: Ronin did not answer at $url" >&2
  exit 5
}
python3 - "$code" "$out" <<'PY'
import json, sys
code, path = int(sys.argv[1]), sys.argv[2]
try:
    data = json.load(open(path))
except Exception:
    data = {}
if code == 200 and data.get("ok"):
    print(f"REHYDRATED {data.get('name') or '?'}")
    raise SystemExit(0)
print(f"REFUSED: {data.get('error') or f'HTTP {code}'}", file=sys.stderr)
raise SystemExit(4)
PY
