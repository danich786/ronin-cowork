#!/usr/bin/env bash
set -euo pipefail

help() {
  cat <<'EOF'
tejun-kanban — read one Team Kanban as JSON

Usage:
  tejun-kanban <team>

The result is derived from the Team roster, live and archived Agent work records,
hand-in receipts, promotions, and master. It stores nothing.
EOF
}

case "${1:-}" in -h|--help) help; exit 0 ;; esac
[ "$#" -eq 1 ] || { echo "usage: tejun-kanban <team>. Run tejun-kanban --help." >&2; exit 2; }
TEAM="$1"
[[ "$TEAM" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || { echo "tejun-kanban: invalid team name: $TEAM" >&2; exit 2; }
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
out=$(mktemp)
trap 'rm -f "$out"' EXIT
code=$(curl -sS -m 20 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$out" -w '%{http_code}' "$url/api/teams/$TEAM/kanban" 2>/dev/null) \
  || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; exit 5; }
if [ "$code" -ge 200 ] && [ "$code" -lt 300 ]; then cat "$out"; printf '\n'; exit 0; fi
python3 - "$out" <<'PY'
import json, sys
try: print(json.load(open(sys.argv[1])).get('error') or 'Ronin refused the Kanban read', file=sys.stderr)
except Exception: print('Ronin refused the Kanban read', file=sys.stderr)
PY
exit 4
