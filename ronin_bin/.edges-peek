#!/usr/bin/env bash
# edges read — read a session's recent output in one call.
# Usage: edges read <session> [lines=60]
set -u
[ $# -ge 1 ] || { echo "usage: edges read <session> [lines]" >&2; exit 2; }
S="$1"; N="${2:-60}"

tmux has-session -t "$S" 2>/dev/null || { echo "NO-SESSION: '$S' does not exist"; exit 3; }
tmux capture-pane -p -e -t "$S" -S -"$N" | sed 's/\x1b\[[0-9;]*m//g' | grep -v '^[[:space:]]*$'
