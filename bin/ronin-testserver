#!/usr/bin/env bash
# Isolated tmux servers for release candidate gates and development tests.
# Every command uses the returned wrapper; close refuses the live server.
set -u

usage() {
  printf 'usage: ronin-testserver open <name> [--conf <file>]\n       ronin-testserver close <name>\n       ronin-testserver list\n' >&2
  exit 2
}

base=${RONIN_TESTSERVER_ROOT:-/tmp/ronin-testserver}
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if [ -x "$repo/vendor/tmux" ]; then
  tmux_bin="$repo/vendor/tmux"
else
  # Session PATH can contain the live-server guard shim. Tests need a real
  # binary; only this tool may close the isolated socket it allocated.
  tmux_bin=''
  for candidate in /usr/bin/tmux /opt/homebrew/bin/tmux /usr/local/bin/tmux; do
    if [ -x "$candidate" ]; then tmux_bin="$candidate"; break; fi
  done
  [ -n "$tmux_bin" ] || { echo 'ronin-testserver: tmux is absent' >&2; exit 1; }
fi
action=${1:-}
name=${2:-}

valid_name() { [[ $1 =~ ^[A-Za-z0-9_-]{1,32}$ ]]; }
server_pid() { "$1" display-message -p '#{pid}' 2>/dev/null; }
live_pid() { env -u TMUX -u TMUX_PANE "$tmux_bin" display-message -p '#{pid}' 2>/dev/null || true; }

case "$action" in
  open)
    valid_name "$name" || usage
    [ -x "$tmux_bin" ] || { printf 'ronin-testserver: %s is absent\n' "$tmux_bin" >&2; exit 1; }
    root="$base/$name"
    wrapper="$root/tmux"
    conf="$root/start.conf"
    mkdir -p "$root"
    {
      printf '#!/usr/bin/env bash\n'
      printf 'exec env -u TMUX -u TMUX_PANE TMUX_TMPDIR=%q %q -L %q "$@"\n' "$root" "$tmux_bin" "$name"
    } >"$wrapper"
    chmod 755 "$wrapper"
    if pid=$(server_pid "$wrapper"); then
      state='already open'
    else
      state='open'
      if [ "${3:-}" = --conf ]; then
        [ $# -eq 4 ] && [ -f "${4:-}" ] || usage
        conf=$4
      elif [ $# -ne 2 ]; then
        usage
      else
        printf 'set-option -s exit-empty off\n' >"$conf"
      fi
      "$wrapper" -f "$conf" start-server
      pid=$(server_pid "$wrapper") || { printf 'ronin-testserver: %s did not start\n' "$name" >&2; exit 1; }
    fi
    printf 'TESTSERVER %s (%s)\n' "$name" "$state"
    printf '  tmux     %s\n' "$wrapper"
    printf '  socket   %s\n' "$root/tmux-$(id -u)/$name"
    printf '  pid      %s\n' "$pid"
    printf '  live     %s  (not this one; nothing here can reach it)\n' "$(live_pid || true)"
    ;;
  close)
    valid_name "$name" || usage
    [ $# -eq 2 ] || usage
    root="$base/$name"
    wrapper="$root/tmux"
    if [ ! -x "$wrapper" ] || ! pid=$(server_pid "$wrapper"); then
      printf 'already closed: %s\n' "$name"
      [ ! -e "$root" ] || rm -r -- "$root"
      exit 0
    fi
    live=$(live_pid)
    if [ -n "$live" ] && [ "$pid" = "$live" ]; then
      printf 'REFUSING: %s resolves to the live server\n' "$name" >&2
      exit 4
    fi
    "$wrapper" kill-server || exit $?
    rm -r -- "$root"
    printf 'CLOSED %s (pid %s)\n' "$name" "$pid"
    ;;
  list)
    [ $# -eq 1 ] || usage
    [ -d "$base" ] || exit 0
    shopt -s nullglob
    for root in "$base"/*; do
      [ -d "$root" ] || continue
      name=${root##*/}
      wrapper="$root/tmux"
      if [ -x "$wrapper" ] && pid=$(server_pid "$wrapper"); then
        printf '%s pid %s\n' "$name" "$pid"
      else
        printf '%s dead\n' "$name"
      fi
    done
    ;;
  *) usage ;;
esac
