#!/usr/bin/env bash
# ronin-bundle — a template bundle in and out of this install.
#
# Usage: ronin-bundle pack <team> [--agents a,b] [--ways y] [--library z]
#                                 [--tools t] [--version v] [--out file]
#        ronin-bundle plan <file.json>                 what an install would write, nothing written
#        ronin-bundle install <file.json> [--replace]  install into your stores; the receipt is the answer
#        ronin-bundle card <file.json> --url <rel>     the index card a library carries for it
#
# A BUNDLE IS A TEAM AND EVERYTHING IT READS (docs/templates.md): the team template, the
# agent templates beside it, the Behaviors it names, and their tools — one JSON document,
# `ronin-bundle/1`. `pack` carries only YOUR
# copies out (what ships is on every install already); `install` lands every copy in your
# own stores and never in the repo. The Templates card on the Campaign page does the same
# through the public library; this is the same thing by hand, and how you make one to publish.
#
# src/bundle-cli.ts calls the operator HTTP surface and prints its reply.
set -u
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/../ronin_bin/tool-path.sh"
HERE=$(cd "$(dirname "$SELF")/.." && pwd)
cd "$HERE" || { echo "NO-REPO: cannot reach the Ronin tree"; exit 1; }
exec npx tsx src/bundle-cli.ts "$@"
