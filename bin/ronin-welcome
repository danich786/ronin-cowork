#!/usr/bin/env bash
# ronin-welcome — draw the arrival box again, with whatever address is live NOW.
#
#   ronin-welcome
#
# setup.sh prints the verified address once. This redraws the same compact arrival
# result from current machine state; it reads and changes nothing.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../libexec/ronin-banner.sh
. "$ROOT/libexec/ronin-banner.sh"

if command -v tailscale >/dev/null 2>&1; then
  RONIN_IP="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  NODE_BIN="$ROOT/vendor/node/bin/node"
  [ -x "$NODE_BIN" ] || NODE_BIN="$(command -v node || true)"
  if [ -n "$NODE_BIN" ]; then
    RONIN_FQDN="$(tailscale status --json 2>/dev/null | "$NODE_BIN" -e \
      'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{process.stdout.write((JSON.parse(d).Self.DNSName||"").replace(/\.$/,""))}catch{}})' 2>/dev/null || true)"
  fi
fi
RONIN_BACKEND_HOST="$(ronin_bind "$ROOT")"
export RONIN_IP="${RONIN_IP:-}" RONIN_FQDN="${RONIN_FQDN:-}" RONIN_BACKEND_HOST RONIN_PUBLIC_PORT=4810

PORT="$(ronin_port "$ROOT")"
URL="$(ronin_open_url "$ROOT" "$PORT")"
if [ -z "${RONIN_FQDN:-}" ] || [ "$URL" != "https://$RONIN_FQDN:4810" ]; then
  printf '  Ronin does not have its required private HTTPS address.\n'
  printf '  Check Tailscale with ronin-doctor, then run setup again.\n\n'
  exit 1
fi
ronin_banner "$ROOT" "$URL"
